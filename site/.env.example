# Copy to .env for local dev (never committed - see root .gitignore).
#
# Public Firebase web config for the signup/dashboard pages - safe to
# ship client-side by design (Firebase's actual security boundary is
# server-side token verification, in app/core/firebase.py, not secrecy
# of this config). From your Firebase project settings > General > Your
# apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Which gateway the dashboard calls. Defaults to the local dev gateway
# (docker compose up, from the repo root) if unset.
VITE_GATEWAY_API_BASE_URL=http://localhost:8010

# Copy to .env.local for local dev (docker-compose reads .env.local).
# In production, set these as environment variables rather than shipping a
# file - see "Deploying" in the README.

ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://gateway_user:dev_password@postgres:5432/matchday_gateway_dev

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------

# Who may call this gateway. Comma-separated, each entry either
# `name:secret` or `name:secret:requests_per_minute`:
#
#   GATEWAY_API_KEYS="predify:s3cret:120,analytics:other-secret:30"
#
# Names matter as soon as more than one app calls the gateway - without
# them you cannot tell consumers apart in the logs, revoke one without
# breaking the others, or see which one caused a spike. A bare secret with
# no name still works and shows as `unnamed`.
GATEWAY_API_KEYS=

# The gateway FAILS CLOSED. With no keys configured and this false, every
# request is refused with a 503 naming the setting that fixes it - so a
# deployment that forgets GATEWAY_API_KEYS cannot quietly serve itself to
# anyone who finds it.
#
# Set true for local development only. Never in production.
GATEWAY_ALLOW_ANONYMOUS=true

# Applied to any key that does not state its own limit.
DEFAULT_RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Upstream
# ---------------------------------------------------------------------------

# Free tier: https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_API_KEY=
FOOTBALL_DATA_ORG_BASE_URL=https://api.football-data.org/v4

# football-data.org competition codes. PL=Premier League,
# PD=La Liga (Primera Division), BL1=Bundesliga
TRACKED_COMPETITIONS=PL,PD,BL1

# Off by default. Enables two soccerdata-powered connectors: Understat
# advanced stats (xG, shot maps - and the /fixtures/{id}/goals endpoint
# derives from these) and the Sofascore results backfill.
#
# BOTH reach their sources through TLS fingerprint spoofing - soccerdata's
# HTTP layer replicates a browser's TLS handshake to defeat bot detection.
# That is deliberate evasion of an access control, not an API call with a
# key. Read the README section before enabling; it is off by default so
# the choice is explicit.
#
# Also requires: uv sync --extra soccerdata
ENABLE_SOCCERDATA=false

# Keep the build context small and secrets out of the image.
.git
.github
.venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache

# Never copy real configuration into an image. Production settings come
# from the environment - see the README.
.env
.env.*
!.env.example

docs
Dockerfile.dev
docker-compose*.yml
Makefile

# scripts/ is deliberately NOT excluded - seed_external_ids.py is an
# operational tool a self-hoster needs to be able to run against their
# own deployment, not just locally.

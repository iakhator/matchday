# Copy to .env.local for local dev (docker-compose reads .env.local)

ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://gateway_user:dev_password@postgres:5432/matchday_gateway_dev

# Comma-separated API keys allowed to call this gateway. Leave empty in dev
# to disable auth entirely.
GATEWAY_API_KEYS=

# Free tier: https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_API_KEY=
FOOTBALL_DATA_ORG_BASE_URL=https://api.football-data.org/v4

# football-data.org competition codes. PL=Premier League, PD=La Liga
TRACKED_COMPETITIONS=PL,PD

# Off by default. Enables the Sofascore backfill fallback for finished
# results (manually triggered via POST /admin/backfill-results, never
# automatic). Uses the `soccerdata` library, which spoofs TLS fingerprints
# to get past Sofascore's bot detection - read the README before enabling.
# Also requires: uv sync --extra soccerdata
ENABLE_SOCCERDATA=false
